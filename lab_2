'''
Создаем функцию для сортировки пузырьком
Устанавливаем флаг в значении True
Запускаем цикл пока флаг в значении True
Запускаем цикл по длине списка
В начале прохода цикла флаг в значении False
Если последующий элемент меньше предыдущего,элементы меняем местами, и флаг устанавливается в значении True
Если за весь проход цикла флаг остался в значении False, цикл останавливается
Возвращаем отсортированный список


Создаем функцию для сортировки простым выбором
Запускаем цикл по длине списка
Находим минимальный элемент в неотсортированной части списка
Меняем его местами с текущим элементом
Возвращаем отсортированный список

Создаем функцию для сортировки вставкамм
Запускаем цикл по длине списка
Сохраняем ссылку на индекс предыдущего элемента
Элементы отсортированного сегмента перемещаем вперёд, если они больше элемента для вставки
Вставляем элемент
Возвращаем отсортированный список


Вводим список чисел
Проверяем корректность ввода
Если ввод корректен, даем пользователю выбрать вид сортировки
Если ввод корректный, сортируем список соответствующим методом, который выбрал пользователь 
Выводим отсортированный список


'''










def bubble_sort(spis):
    # Сортировка пузырьком
    swapped = True
    # Устанавливаем флаг, цикл будет работать пока флаг в значении True
    while swapped:
        swapped = False
        for i in range(len(spis) - 1):
            if spis[i] > spis[i + 1]:
                spis[i], spis[i + 1] = spis[i + 1], spis[i]
                # Если последуйщий элемент меньше предыдущего, меняем местами
                swapped = True
                # Устанавливаем флаг в True для следующей итерации
    return spis

                
def findmin(spis, start):
    # Функция для поиска минимального элемента
    mn = start
    for i in range(start + 1, len(spis)):
        if spis[i] < spis[mn]:
            mn = i
        # Если текущий элемент меньше минимального элемента, заменяем индекс мин элемента
    return mn
def prost_choice(spis):
# Сортировка простым выбором
    n = len(spis)
    for i in range(n - 1):
        min_el=findmin(spis,i)
        # находим номер минимального эл-та, начиная с текущего
        spis[i],spis[min_el] = spis[min_el],spis[i]
        # меняем минимальный с текущим эл-том
    return spis

    
                
def insertion_sort(spis):
    # Сортировка вставками
    # Сортировку начинаем со второго элемента, т.к. считается, что первый элемент уже отсортирован
    for i in range(1, len(spis)):
        item_to_insert = spis[i]
        # Текущий элемент
        j = i - 1
        # Сохраняем ссылку на индекс предыдущего элемента
        while j >= 0 and spis[j] > item_to_insert:
            spis[j + 1] = spis[j]
            j -= 1
        # Элементы отсортированного сегмента перемещаем вперёд, если они больше элемента для вставки
        spis[j + 1] = item_to_insert
        # Вставляем элемент
    return spis
spis_input=input('Введите список чисел, который вы хотите отсортировать: ').split()
# Вводим список чисел
z=True
spis_sort=[]
for i in spis_input:
    if not i.isdigit():
        if i[0]!='-':
            z=False
        else:
            if not i[1:].isdigit():
                z=False
        break
# Проверяем корректность ввода
if z==False:
    print('Ввод неккоректен.')
else:
    spis_input=list(map(int,spis_input))
    # Преобразуем элементы списка в целые значения
    sort_choice=input('Выберите одну из 3 сортировок: сортировка пузырьком, сортировка простым выбором, сортировка вставками: ')
    # Дает пользователю выбрать сортировку
    if sort_choice=='сортировка пузырьком':
        spis_sort=bubble_sort(spis_input)
    elif sort_choice=='сортировка простым выбором':
        spis_sort=prost_choice(spis_input)
    elif sort_choice=='сортировка вставками':
        spis_sort=insertion_sort(spis_input)
    else:
        print('Ввод неккоректен. Выберите нужную сортировку.')
    # Сортируем список соответствующим методом, который выбрал пользователь 
if len(spis_sort)!=0:
    print(*spis_sort)
# Выводим отсортированный список

    
    
