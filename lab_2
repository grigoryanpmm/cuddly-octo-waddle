         Пробуем преобразовать введенные данные в список целых чисел
             Если преобразование не удалось, выводим ошибку 

         Запрашиваем у пользователя выбор метода сортировки
         Если метод корректен:
             Вызываем соответствующую функцию сортировки и выводим результаты
         В противном случае:
             Выводим сообщение об ошибке

 Конец программы
'''








def bubble_sort(spis):
    swapped = True
    colvo_sravn=0
    colvo_per=0
    while swapped:
        swapped = False
        for i in range(len(spis) - 1):
            colvo_sravn+=1
            if spis[i] > spis[i + 1]:
                colvo_per+=1
                spis[i], spis[i + 1] = spis[i + 1], spis[i]
                swapped = True
    print(f'При сортировке пузырьком {colvo_sravn} сравн. и {colvo_per} перест.')
    return spis

                
def findmin(spis, start):
    mn = start
    colvo_sravn=0
    for i in range(start + 1, len(spis)):
        if spis[i] < spis[mn]:
            colvo_sravn+=1
            mn = i
    return mn,colvo_sravn
def prost_choice(spis):
    n = len(spis)
    colvo_per=0
    colvo_sravn=0
    for i in range(n - 1):
        min_el,sravn=findmin(spis,i)
        colvo_sravn+=sravn
        colvo_per+=1
        spis[i],spis[min_el] = spis[min_el],spis[i]
    print(f'При сортировке простым выбором {colvo_sravn} сравн. и {colvo_per} перест.')
    return spis

    
                
def insertion_sort(spis):
    colvo_sravn=0
    colvo_per=0
    for i in range(1, len(spis)):
        item_to_insert = spis[i]
        j = i - 1
        while j >= 0 and spis[j] > item_to_insert:
            colvo_sravn+=1
            spis[j + 1] = spis[j]
            j -= 1
        if i!=j+1:
            colvo_per+=1
            spis[j + 1] = item_to_insert
    print(f'При сортировке вставками {colvo_sravn} сравн. и {colvo_per} перест.')
    return spis

