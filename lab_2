        mn = start
        for i in range(start + 1, len(x)):
            if x[i] < x[mn]:
                mn = i
                return mn
    n = len(s)
    for i in range(n - 1):
        k=findmin(s,i) # находим номер минимального эл-та, начиная с текущего
        s[i],s[k] = s[k],s[i] # меняем минимальный с текущим эл-том
    return s
            
